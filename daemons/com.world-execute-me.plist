<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.world-execute-me</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PY__</string>
    <string>__ROOT__/scripts/yandere_agent.py</string>
    <string>watch</string>
    <string>--interval</string>
    <string>15</string>
    <string>--peek</string>
    <string>--peek-every</string>
    <string>5</string>
    <string>--escalate</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/world-execute-me.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/world-execute-me.log</string>
</dict>
</plist>
